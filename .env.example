# Copy to .env and fill in your own credentials.
# Only the LLM-baseline scripts need these; the deterministic cascade runs without them.

DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: embedding / knowledge-graph context providers
ARK_DOUBAO_API_KEY=your-ark-key-here
ARK_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
